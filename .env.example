# ANTHROPIC_API_KEY: Required for Claude API calls (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Claude models (optional). Turbo mode uses the faster, lower-quality model.
# CLAUDE_MODEL="claude-opus-5-5"
# CLAUDE_TURBO_MODEL="claude-haiku-5-5"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_PATH: Optional SQLite file location (default: ./data/dealpulse.db).
# DATABASE_PATH="./data/dealpulse.db"

# ALLOW_LOCAL_WEBHOOKS: Development only. Lets webhooks target http:// and private hosts.
# ALLOW_LOCAL_WEBHOOKS="true"

# Optional connection providers (brokers choose them on the Connections page).
# Microsoft 365 (Outlook mail, Outlook Calendar, OneDrive): Azure app registration, SPA platform,
# redirect URI <app origin>/auth/microsoft. Built into the frontend at build time.
# VITE_MICROSOFT_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# Dropbox (files): Dropbox app with redirect URI <app origin>/auth/dropbox and scopes
# account_info.read, files.metadata.read, files.content.read, files.content.write.
# VITE_DROPBOX_APP_KEY="your-dropbox-app-key"
